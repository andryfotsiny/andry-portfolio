// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Profile principal
model Profile {
  id          String   @id @default(cuid())
  name        String
  title       String
  description String
  email       String
  phone       String?
  location    String?
  photoUrl    String?
  githubUrl   String?
  linkedinUrl String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Statistiques
model Stats {
  id            String   @id @default(cuid())
  projectsCount Int      @default(0)
  yearsExp      Int      @default(0)
  skillsCount   Int      @default(0)
  updatedAt     DateTime @updatedAt
}

// Catégories de compétences
model SkillCategory {
  id        String   @id @default(cuid())
  name      String
  icon      String
  order     Int      @default(0)
  skills    Skill[]
  createdAt DateTime @default(now())
}

// Compétences techniques
model Skill {
  id         String        @id @default(cuid())
  name       String
  categoryId String
  category   SkillCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  order      Int           @default(0)
  createdAt  DateTime      @default(now())
}

// Langues
model Language {
  id        String   @id @default(cuid())
  name      String
  level     String
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

// Projets
model Project {
  id           String   @id @default(cuid())
  titre        String
  description  String
  technologies String
  githubUrl    String?
  liveUrl      String?
  imageUrl     String?
  featured     Boolean  @default(false)
  order        Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Expériences professionnelles
model Experience {
  id           String    @id @default(cuid())
  poste        String
  entreprise   String
  periode      String
  description  String
  technologies String
  startDate    DateTime?
  endDate      DateTime?
  current      Boolean   @default(false)
  order        Int       @default(0)
  createdAt    DateTime  @default(now())
}

// Formations académiques
model Formation {
  id          String   @id @default(cuid())
  periode     String
  titre       String
  ecole       String
  icon        String
  description String?
  link        String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
}

// Certifications
model Certification {
  id        String   @id @default(cuid())
  date      String
  titre     String
  organisme String
  icon      String
  link      String?
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

// Informations de contact
model ContactInfo {
  id    String  @id @default(cuid())
  type  String
  label String
  value String
  link  String?
  icon  String
  order Int     @default(0)
}

// Messages de contact
model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}
